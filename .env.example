# =========================================================================
# PakPattan Services Hub — Environment Variables Reference
# Add these to Netlify Site Settings > Environment Variables for persistent production Firestore
# =========================================================================

# Client-Side Firebase Configuration (Vite requires VITE_ prefix)
VITE_FIREBASE_API_KEY="AIzaSyYourActualApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="pakpattan-services-hub.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="pakpattan-services-hub"
VITE_FIREBASE_STORAGE_BUCKET="pakpattan-services-hub.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# Optional Gemini API Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Deployment App URL
APP_URL="https://pakpattanconnect.netlify.app"
